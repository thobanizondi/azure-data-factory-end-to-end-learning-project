{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-aw-project-thobani"
		},
		"azure_sql_demo_db_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'azure_sql_demo_db'"
		},
		"azure_sql_demo_db_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "demo-server-thobani.database.windows.net"
		},
		"azure_sql_demo_db_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "demo-db"
		},
		"azure_sql_demo_db_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "thobani"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/ds_sql_server')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "azure_sql_demo_db",
					"type": "LinkedServiceReference"
				},
				"annotations": [],
				"type": "AzureSqlTable",
				"schema": [
					{
						"name": "CustomerID",
						"type": "int",
						"precision": 10
					},
					{
						"name": "CustomerName",
						"type": "varchar"
					},
					{
						"name": "Region",
						"type": "varchar"
					},
					{
						"name": "Email",
						"type": "varchar"
					},
					{
						"name": "ModifiedDate",
						"type": "datetime2",
						"scale": 7
					}
				],
				"typeProperties": {
					"schema": "dbo",
					"table": "Customers"
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/azure_sql_demo_db')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/azure_sql_demo_db')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "AzureSqlDatabase",
				"typeProperties": {
					"server": "[parameters('azure_sql_demo_db_properties_typeProperties_server')]",
					"database": "[parameters('azure_sql_demo_db_properties_typeProperties_database')]",
					"encrypt": "mandatory",
					"trustServerCertificate": false,
					"authenticationType": "SQL",
					"userName": "[parameters('azure_sql_demo_db_properties_typeProperties_userName')]",
					"password": {
						"type": "SecureString",
						"value": "[parameters('azure_sql_demo_db_password')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}